# Application
APP_PORT=3000
APP_ENV=development
APP_URL=http://localhost:3000
API_PREFIX=api

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=salembeauty
DB_PASSWORD=salembeauty_dev
DB_DATABASE=salembeauty_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT
JWT_SECRET=salembeauty-jwt-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=salembeauty-jwt-refresh-secret-change-in-production
JWT_REFRESH_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# File Upload
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@salembeauty.com
